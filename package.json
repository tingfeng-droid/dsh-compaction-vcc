{
  "name": "dsh-compaction-vcc",
  "version": "0.7.3",
  "description": "VCC-style instant, near-lossless deterministic compaction engine for the DeepSeek Harness — a drop-in replacement for @deepseek-ai/dsh-compaction-basic. Fork of TsFreddie/dsh-compaction-instant (MIT) with host 0.2.2 toolCallId compatibility fixes.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./compiler": {
      "types": "./types/compiler.d.ts",
      "default": "./src/compiler.js"
    },
    "./region": {
      "types": "./types/region.d.ts",
      "default": "./src/region.js"
    },
    "./recall": {
      "types": "./types/recall.d.ts",
      "default": "./src/recall.js"
    },
    "./search": {
      "types": "./types/search.d.ts",
      "default": "./src/search.js"
    },
    "./tool": {
      "types": "./types/tool.d.ts",
      "default": "./src/tool.js"
    },
    "./command": {
      "types": "./types/command.d.ts",
      "default": "./src/command.js"
    },
    "./preset-check": {
      "types": "./types/preset-check.d.ts",
      "default": "./src/preset-check.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/compiler.js && node --check src/region.js && node --check src/recall.js && node --check src/search.js && node --check src/tool.js && node --check src/command.js && node --check src/preset-check.js && node --check src/shadow-check.js && node --check src/session-compat.js"
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.2-rc.1"
  },
  "keywords": [
    "cordis",
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-compression",
    "vcc",
    "token"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "author": "TsFreddie (original dsh-compaction-instant); fork maintained by Tingfeng",
  "contributors": [
    "TsFreddie — original author of dsh-compaction-instant"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tingfeng-droid/dsh-compaction-vcc.git"
  },
  "bugs": {
    "url": "https://github.com/tingfeng-droid/dsh-compaction-vcc/issues"
  },
  "homepage": "https://github.com/tingfeng-droid/dsh-compaction-vcc#readme",
  "upstream": {
    "name": "dsh-compaction-instant",
    "author": "TsFreddie",
    "version": "0.1.4",
    "url": "https://github.com/TsFreddie/dsh-compaction-instant",
    "license": "MIT"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
